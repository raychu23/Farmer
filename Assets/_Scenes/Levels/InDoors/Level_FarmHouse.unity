  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6989466901774546af9c8c3e426e377, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayer: {fileID: 1350976805}
  messages1:
  - 'Bob: Hello! I''m Bob, an agronomist.'
  - 'Bob: I review research to help decide the best way to use farmland and increase
    crop yields.'
  messages2:
  - 'Bob: Do you find your crop yields decreasing, even though you give them the same
    amount of water?'
  - 'Bob: Soil nutrition, such as nitrate levels, are probably getting drained out
    of your field by your crops.'
  - 'Bob: Switching up the crops you plant can help!'
  - 'Bob: Fertilizer can also really boost nitrate levels!'
  - 'Bob: Adding too much can get pricey, though.'
  messages3:
  - 'Bob: I heard there''s a big drought coming.'
  - 'Bob: You should stock up on water before prices rise.'
  messages4:
  - Hello, there.
