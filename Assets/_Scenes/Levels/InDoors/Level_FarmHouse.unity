  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6989466901774546af9c8c3e426e377, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  displayer: {fileID: 1350976805}
  messages1:
  - 'Hannah: Hi, I''m Hannah. I work as an environmentalist for the EPA.'
  - 'Hannah: Are you having a tough time saving money? Try investing in a composter!'
  - 'Hannah: It''s eco-friendly, and it slows nitrate depletion by half!'
  - 'Hannah: With this tool, you won''t have to use as much fertilizer...'
  - 'Hannah: Which may help you avoid fines, since the EPA is really cracking down
    on runoff pollution.'
  messages2:
  - 'Hannah: Pests can lower yields for all types of crops.'
  - 'Hannah: It can be tempting to keep adding pesticides, but this hurts the environment.'
  - 'Hannah: To avoid the fines and pollution, try to keep rotating your crops!'
  - 'Hannah: This decreases the chance of pests appearing in your fields.'
  messages3:
  - Hello!
  messages4:
  - How are you?
